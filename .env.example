# Copy to .env (never commit .env). Values in «guillemets» count as unset.
HF_TOKEN=«your-huggingface-read-token»
# MNOTES_ASR_MODEL=mlx-community/whisper-large-v3-mlx
# HF_HOME=«path-for-model-cache»
# CHROME=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome   # only if PDF export can't find a browser
HF_HUB_DISABLE_TELEMETRY=1
